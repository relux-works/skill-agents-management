+// TestAGroupSomebodyElseIsProbingIsNotHealthy covers the fourth group state.
+func TestAGroupSomebodyElseIsProbingIsNotHealthy(t *testing.T) {
+	f := newVerdictFixture(t, ProviderClaude)
