+func TestLeaseMutatorsRequireALease(t *testing.T) {
+	f := newStoreFixture(t)
+	if err := f.store.AbandonProbe(f.identity, codexPlan, Lease{}); err == nil {
+		t.Fatal("AbandonProbe must refuse a zero lease")
