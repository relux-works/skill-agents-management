+		t.Fatalf("a step just under 6h must be admitted: %v", err)
+	}
+	if err := ValidateLadder([]time.Duration{6*time.Hour + time.Second}); err == nil {
+		t.Fatal("a step just over 6h must be rejected")
+	}
