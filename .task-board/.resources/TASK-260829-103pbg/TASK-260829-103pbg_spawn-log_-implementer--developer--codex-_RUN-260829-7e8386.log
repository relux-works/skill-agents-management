+		{"quarantined_until", "not-a-timestamp"},
+		{"last_readiness_match", "not-a-timestamp"},
+		{"manual_quarantine", "false"},
+		{"manual_quarantine", nil},
+		{"half_open", "true"},
+		{"half_open", nil},
+	} {
+		t.Run(tc.field, func(t *testing.T) {
+			fixture := validFixture()
+			for key, value := range map[string]any{
