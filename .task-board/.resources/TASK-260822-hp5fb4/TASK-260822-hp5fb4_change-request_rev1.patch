+	// child is given the one identity it may mutate.
+	ContextID string
+}
+
+// IsZero reports whether no run context was supplied at all.
+func (c RunContext) IsZero() bool {
+	return c.RunID == "" && c.TaskID == "" && c.BoardDir == "" && c.ContextID == ""
