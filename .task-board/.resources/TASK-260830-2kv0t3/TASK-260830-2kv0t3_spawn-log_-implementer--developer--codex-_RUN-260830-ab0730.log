+		req.Engine = other
+		_, err := BuildLaunch(context.Background(), registry, req, agentic.LaunchModeExec)
+		if !errors.Is(err, ErrInferenceEngineMismatch) {
+			t.Fatalf("BuildLaunch substitution err = %v, want ErrInferenceEngineMismatch", err)
