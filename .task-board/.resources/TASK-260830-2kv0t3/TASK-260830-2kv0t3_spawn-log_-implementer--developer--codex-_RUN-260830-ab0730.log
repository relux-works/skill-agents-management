+type identityVendor struct{ *narwhalVendor }
+
+func (v *identityVendor) Spawn(sc SpawnContext) (agentic.LaunchRequest, error) {
+	launch, err := v.narwhalVendor.Spawn(sc)
+	launch.Profile = sc.Request.Profile
+	return launch, err
+}
