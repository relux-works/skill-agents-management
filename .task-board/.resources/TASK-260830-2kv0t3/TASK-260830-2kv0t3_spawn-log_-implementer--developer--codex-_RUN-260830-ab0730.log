+	preflightCalls int
+}
+
+func (s *identitySystem) Preflight(context.Context, agentic.LaunchRequest) (agentic.PreflightEvidence, error) {
+	s.preflightCalls++
+	return agentic.PreflightEvidence{}, nil
+}
