+	if _, err := plan.ConsumerProvenance(); !errors.Is(err, agentic.ErrLaunchProvenanceMismatch) {
+		t.Fatalf("ConsumerProvenance(corrupted BuildLaunch output) = %v, want ErrLaunchProvenanceMismatch", err)
+	}
+}
