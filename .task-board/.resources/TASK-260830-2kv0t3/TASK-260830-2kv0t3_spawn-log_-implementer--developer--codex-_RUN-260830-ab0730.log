+		}
+		entry, _ := runtimeEntry(result.Config, "local-qwen")
+		if entry.Engine == entry.Models["qwen-3.8-27b-mlx-8bit"].Engine {
+			t.Fatal("test fixture did not produce distinct runtime/model engine refs")
