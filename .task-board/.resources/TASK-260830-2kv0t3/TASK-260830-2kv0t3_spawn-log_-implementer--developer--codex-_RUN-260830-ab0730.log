+func configuredEngineRef(cfg Config, raw *string) (plugin.Ref, error) {
+	if raw == nil {
+		return plugin.Ref{}, nil
+	}
+	if strings.TrimSpace(*raw) == "" {
+		return plugin.Ref{}, errors.New("engine is present but blank")
+	}
