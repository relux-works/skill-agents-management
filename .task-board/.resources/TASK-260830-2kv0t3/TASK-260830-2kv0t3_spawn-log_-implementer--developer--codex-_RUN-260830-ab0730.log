+	for _, id := range cfg.InferenceEngines {
+		if string(id) == *raw {
+			return plugin.Ref{ID: id, Kind: inferenceengine.Kind}, nil
+		}
+	}
+	return plugin.Ref{}, fmt.Errorf("engine %q is not declared in inference_engines", *raw)
+}
