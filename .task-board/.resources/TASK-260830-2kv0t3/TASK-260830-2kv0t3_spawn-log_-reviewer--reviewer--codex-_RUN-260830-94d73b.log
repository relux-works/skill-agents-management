   565	func launchIdentityCorpus() []launchIdentityTuple {
   566		tuples := []launchIdentityTuple{
   567			{system: "pi", vendor: "local-models", runtime: "local-qwen", profile: "local-qwen", publisher: "alibaba", family: "qwen", model: "qwen-3.8-27b-mlx-8bit", engine: "mlx"},
   568			{system: "sable-harness", vendor: "cedar-broker", runtime: "ember-runtime", profile: "frost-profile", publisher: "garnet-publisher", family: "heron-family", model: "indigo-model-v1", engine: "juniper-engine"},
   569			{system: "kestrel-harness", vendor: "lilac-broker", runtime: "marble-runtime", profile: "nectar-profile", publisher: "onyx-publisher", family: "pebble-family", model: "quartz-model-v2", engine: "raven-engine"},
   570		}
   571		rng := rand.New(rand.NewSource(260830))
   572		for caseIndex := 0; caseIndex < 8; caseIndex++ {
   573			value := func(axis string) string { return fmt.Sprintf("%s-%02d-%08x", axis, caseIndex, rng.Uint32()) }
   574			tuples = append(tuples, launchIdentityTuple{
   575				system: value("sys"), vendor: value("ven"), runtime: value("run"), profile: value("pro"),
   576				publisher: value("pub"), family: value("fam"), model: value("mod"), engine: value("eng"),
   577			})
   578		}
   579		return tuples
   580	}
   581	
   582	func requireInjectiveIdentityTuple(t *testing.T, ids launchIdentityTuple) {
   583		t.Helper()
   584		values := []string{ids.system, ids.vendor, ids.runtime, ids.profile, ids.publisher, ids.family, ids.model, ids.engine}
   585		seen := make(map[string]bool, len(values))
   586		for _, value := range values {
   587			if seen[value] {
   588				t.Fatalf("identity rename is not injective: tuple %+v repeats %q", ids, value)
   589			}
   590			seen[value] = true
   591		}
   592	}
   593	
   594	func canonicalIdentityPlan(plan agentic.Plan, ids launchIdentityTuple) agentic.Plan {
   595		plan.System = "{system}"
   596		plan.Provenance = agentic.LaunchProvenance{}
   597		replacements := map[string]string{
   598			ids.system: "{system}", ids.vendor: "{vendor}", ids.runtime: "{runtime}", ids.profile: "{profile}",
   599			ids.publisher: "{publisher}", ids.family: "{family}", ids.model: "{model}", ids.engine: "{engine}",
   600		}
   601		for index, value := range plan.Argv {
   602			if replacement, ok := replacements[value]; ok {
   603				plan.Argv[index] = replacement
   604			}
   605		}
   606		for index, value := range plan.Env {
   607			if replacement, ok := replacements[value]; ok {
   608				plan.Env[index] = replacement
   609			}
   610		}
   611		return plan
   612	}
   613	
   614	func identityGraphSignature(t *testing.T, registry *Registry, ids launchIdentityTuple) []string {
   615		t.Helper()
   616		axes := map[plugin.ID]string{
   617			plugin.ID(ids.system): "system", plugin.ID(ids.vendor): "vendor", plugin.ID(ids.engine): "engine",
   618		}
   619		result := make([]string, 0, len(axes))
   620		for id, axis := range axes {
   621			declaration, ok := registry.Graph().Declaration(id)
   622			if !ok {
   623				t.Fatalf("graph omitted %s identity %q", axis, id)
   624			}
   625			dependencies := make([]string, 0, len(declaration.Dependencies))
   626			for _, dependency := range declaration.Dependencies {
   627				dependencyAxis, ok := axes[dependency.ID]
   628				if !ok {
   629					t.Fatalf("%s identity %q has unexpected dependency %#v", axis, id, dependency)
   630				}
   631				dependencies = append(dependencies, dependencyAxis+":"+string(dependency.Kind))
   632			}
   633			sort.Strings(dependencies)
   634			result = append(result, axis+":"+string(declaration.Kind)+":"+fmt.Sprint(dependencies))
   635		}
   636		sort.Strings(result)
   637		return result
   638	}
