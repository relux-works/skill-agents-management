   249				},
   250				want: inferenceengine.ErrProfileExpansionInvalid,
   251			},
   252		}
   253		for _, test := range tests {
   254			t.Run(test.name, func(t *testing.T) {
   255				ids := launchIdentityCorpus()[0]
   256				engine := plugin.Ref{ID: "mlx", Kind: inferenceengine.Kind}
   257				fixture := newIdentityLaunchFixture(t, ids, engine, engine)
   258				fixture.registry.engineFacts = &scriptedEngineFactSource{overrides: test.overrides}
   259	
   260				_, err := BuildLaunch(context.Background(), fixture.registry, fixture.request, agentic.LaunchModeExec)
   261				if !errors.Is(err, test.want) {
   262					t.Fatalf("BuildLaunch error = %v, want %v", err, test.want)
   263				}
   264				if fixture.vendor.calls["Spawn"] != 0 || fixture.system.preflightCalls != 0 {
   265					t.Fatalf("refusal reached launch effects: Spawn=%d Preflight=%d", fixture.vendor.calls["Spawn"], fixture.system.preflightCalls)
   266				}
   267			})
   268		}
   269	}
