   120	// BuildLaunch is the production call site: it must resolve the declaration's
   121	// requested engine through the same graph that registered systems and vendors.
   122	func TestBuildLaunchCarriesRequestedAndResolvedEngineProvenance(t *testing.T) {
   123		registry := engineRegistry(t, testEngineRef, testEngineRef)
   124		req := narwhalRequest()
   125		req.Engine = testEngineRef
   126	
   127		plan, err := BuildLaunch(context.Background(), registry, req, agentic.LaunchModeExec)
   128		if err != nil {
   129			t.Fatalf("BuildLaunch: %v", err)
   130		}
   131		if plan.Provenance.Runtime != string(req.Runtime) || plan.Provenance.Model != string(req.Model) {
   132			t.Fatalf("provenance runtime/model = %q/%q, want %q/%q", plan.Provenance.Runtime, plan.Provenance.Model, req.Runtime, req.Model)
   133		}
   134		if plan.Provenance.Publisher != "narwhal-labs" || plan.Provenance.Family != "narwhal" {
   135			t.Fatalf("publisher/family = %q/%q", plan.Provenance.Publisher, plan.Provenance.Family)
   136		}
   137		if plan.Provenance.RequestedEngine != testEngineRef || plan.Provenance.ResolvedEngine != testEngineRef {
   138			t.Fatalf("engine provenance = %#v/%#v, want %#v", plan.Provenance.RequestedEngine, plan.Provenance.ResolvedEngine, testEngineRef)
   139		}
   140	}
