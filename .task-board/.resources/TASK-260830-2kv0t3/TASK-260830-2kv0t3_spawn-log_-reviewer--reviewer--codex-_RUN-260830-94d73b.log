   186	// Equal refs are not corroborating evidence when both were forged. Drive the
   187	// same persisted consumer surface and narrow each graph identity rule in turn.
   188	func TestBuildLaunchLocalQwenPersistedProvenanceRefusesEqualForgedEngineRefs(t *testing.T) {
   189		for _, test := range []struct {
   190			name string
   191			id   string
   192			kind string
   193			want error
   194		}{
   195			{name: "normalized correct-kind unconfigured identity", id: "attacker-engine", kind: "inference-engine", want: agentic.ErrLaunchProvenanceMismatch},
   196			{name: "wrong kind", id: "mlx", kind: "vendor", want: agentic.ErrLaunchProvenanceInvalid},
   197			{name: "unnormalized id", id: "MLX", kind: "inference-engine", want: agentic.ErrLaunchProvenanceInvalid},
   198			{name: "unnormalized kind", id: "mlx", kind: "Inference-Engine", want: agentic.ErrLaunchProvenanceInvalid},
   199		} {
   200			t.Run(test.name, func(t *testing.T) {
   201				registry, projection := buildLocalQwenConsumerProvenance(t)
   202				persisted := mutatePersistedProvenance(t, projection, func(record map[string]any) {
   203					for _, field := range []string{"configured_engine", "resolved_engine"} {
   204						ref := record[field].(map[string]any)
   205						ref["id"] = test.id
   206						ref["kind"] = test.kind
   207					}
   208				})
   209				if err := registry.ValidateLaunchProvenance(persisted); !errors.Is(err, test.want) {
   210					t.Fatalf("ValidateLaunchProvenance(equal forged refs) = %v, want %v", err, test.want)
   211				}
   212			})
   213		}
   214	}
