   206			name      string
   207			overrides map[inferenceengine.Fact]inferenceengine.ReadOutcome
   208			want      error
   209		}{
   210			{
   211				name: "read failure is not absence",
   212				overrides: map[inferenceengine.Fact]inferenceengine.ReadOutcome{
   213					inferenceengine.FactReadiness: inferenceengine.ReadFailure(inferenceengine.NotObservedReadFailure, "status read failed"),
   214				},
   215				want: inferenceengine.ErrObservationRead,
   216			},
   217			{
   218				name: "arbitrary readiness json",
   219				overrides: map[inferenceengine.Fact]inferenceengine.ReadOutcome{
   220					inferenceengine.FactReadiness: inferenceengine.ReadValue(`{"endpoint_answering":true,"weights_resident":false}`),
   221				},
   222				want: inferenceengine.ErrObservationMalformed,
   223			},
   224			{
   225				name: "readiness without resident weights",
   226				overrides: map[inferenceengine.Fact]inferenceengine.ReadOutcome{
   227					inferenceengine.FactReadiness: inferenceengine.ReadValue(`{"weights_resident":false}`),
   228				},
   229				want: inferenceengine.ErrObservationMalformed,
   230			},
   231			{
   232				name: "arbitrary busy json",
   233				overrides: map[inferenceengine.Fact]inferenceengine.ReadOutcome{
   234					inferenceengine.FactInferenceBusy: inferenceengine.ReadValue(`{"busy":"sometimes"}`),
   235				},
   236				want: inferenceengine.ErrObservationMalformed,
   237			},
   238			{
   239				name: "arbitrary pressure json",
   240				overrides: map[inferenceengine.Fact]inferenceengine.ReadOutcome{
   241					inferenceengine.FactMemoryPressureSequence: inferenceengine.ReadValue(`{"pressure":"critical","action":"evict"}`),
   242				},
   243				want: inferenceengine.ErrObservationMalformed,
   244			},
   245			{
