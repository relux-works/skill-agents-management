    33	type countingStatusReader struct {
    34		status localruntime.Status
    35		err    error
    36		hang   bool
    37		calls  int
    38	}
    39	
    40	func (r *countingStatusReader) Status(ctx context.Context, _ localruntime.StatusQuery) (localruntime.Status, error) {
    41		r.calls++
    42		if r.hang {
    43			<-ctx.Done()
    44			return localruntime.Status{}, ctx.Err()
    45		}
    46		if r.err != nil {
    47			return localruntime.Status{}, r.err
    48		}
    49		return r.status, nil
    50	}
    51	
    52	// isolatedLocalQwenRegistry builds a registry carrying ONLY the real pi
    53	// system (with the given fake StatusReader) and this vendor (with the given
    54	// config), declaring local-qwen.
    55	func isolatedLocalQwenRegistry(t *testing.T, reader localruntime.StatusReader, cfg Config, configuredPlugins ...plugin.Plugin) *vendorplugin.Registry {
    56		t.Helper()
    57		systems := agentic.NewRegistry()
    58		if err := systems.Register(pi.New(reader)); err != nil {
    59			t.Fatalf("registering pi: %v", err)
    60		}
    61		registry := vendorplugin.NewRegistry(systems)
    62		if len(configuredPlugins) == 0 {
    63			configuredPlugins = cfg.EnginePlugins()
    64		}
    65		for _, engine := range configuredPlugins {
    66			if err := registry.RegisterPlugin(engine); err != nil {
    67				t.Fatalf("registering configured engine: %v", err)
    68			}
    69		}
    70		if err := registry.Register(New(cfg)); err != nil {
    71			t.Fatalf("registering local-models: %v", err)
    72		}
    73		decl := vendorplugin.RuntimeDeclaration{
    74			ID:     "local-qwen",
    75			System: "pi",
    76			Vendor: VendorID,
    77			Broker: vendorplugin.BrokerProvenance{Checked: []string{"test"}, Found: "test"},
    78			Engine: cfg.Runtimes[0].Engine,
    79		}
    80		if err := registry.DeclareRuntime(decl); err != nil {
    81			t.Fatalf("declaring local-qwen: %v", err)
    82		}
    83		return registry
    84	}
