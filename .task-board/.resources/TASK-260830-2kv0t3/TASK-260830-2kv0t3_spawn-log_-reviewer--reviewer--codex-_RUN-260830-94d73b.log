   519	type refusalObservation struct {
   520		err       error
   521		plan      agentic.Plan
   522		spawn     int
   523		preflight int
   524	}
   525	
   526	func TestBuildLaunchRefusalClassesAreEquivariantUnderIdentityRenaming(t *testing.T) {
   527		mutations := []struct {
   528			name string
   529			want error
   530			run  func(*testing.T, launchIdentityTuple) refusalObservation
   531		}{
   532			{name: "missing-engine-plugin", want: plugin.ErrMissingDependency, run: missingEngineRefusal},
   533			{name: "engine-wrong-kind", want: plugin.ErrUnsatisfiableDeclaration, run: wrongKindEngineRefusal},
   534			{name: "duplicate-engine-identity", want: plugin.ErrDuplicatePlugin, run: duplicateEngineRefusal},
   535			{name: "cyclic-batch-registration", want: plugin.ErrDependencyCycle, run: cyclicEngineRefusal},
   536			{name: "partial-engine-reference", want: ErrInferenceEngineInvalid, run: partialEngineRefusal},
   537			{name: "unnormalized-engine-reference", want: ErrInferenceEngineInvalid, run: unnormalizedEngineRefusal},
   538			{name: "runtime-model-disagreement", want: ErrInferenceEngineMismatch, run: engineDisagreementRefusal},
   539			{name: "runtime-only-engine", want: ErrInferenceEngineMismatch, run: runtimeOnlyEngineRefusal},
   540			{name: "model-only-engine", want: ErrInferenceEngineMismatch, run: modelOnlyEngineRefusal},
   541			{name: "caller-substitution-replacement", want: ErrInferenceEngineMismatch, run: callerSubstitutionRefusal},
   542			{name: "caller-engine-for-no-engine-declarations", want: ErrInferenceEngineMismatch, run: callerEngineForLegacyRefusal},
   543		}
   544		for _, mutation := range mutations {
   545			t.Run(mutation.name, func(t *testing.T) {
   546				for index, ids := range launchIdentityCorpus() {
   547					t.Run(fmt.Sprintf("case-%02d", index), func(t *testing.T) {
   548						observation := mutation.run(t, ids)
   549						if !errors.Is(observation.err, mutation.want) {
   550							t.Fatalf("identity case %d (%+v): err=%v, want class %v", index, ids, observation.err, mutation.want)
   551						}
   552						if !reflect.DeepEqual(observation.plan, agentic.Plan{}) {
   553							t.Fatalf("identity case %d returned a plan on refusal: %#v", index, observation.plan)
   554						}
   555						if observation.spawn != 0 || observation.preflight != 0 {
   556							t.Fatalf("identity case %d reached launch side effects: vendor Spawn=%d system Preflight=%d",
   557								index, observation.spawn, observation.preflight)
   558						}
   559					})
   560				}
   561			})
   562		}
   563	}
