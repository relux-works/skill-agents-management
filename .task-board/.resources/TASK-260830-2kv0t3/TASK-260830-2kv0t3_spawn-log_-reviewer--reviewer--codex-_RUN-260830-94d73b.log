   472	// BuildLaunch is deliberately the acceptance surface. The fixture changes all
   473	// eight identity axes while leaving its behavior fixed; no helper beneath the
   474	// production entry point is used as a substitute for the launch observation.
   475	func TestBuildLaunchIsEquivariantUnderIdentityRenaming(t *testing.T) {
   476		var baselinePlan agentic.Plan
   477		var baselineGraph []string
   478		for index, ids := range launchIdentityCorpus() {
   479			t.Run(fmt.Sprintf("case-%02d", index), func(t *testing.T) {
   480				if index > 0 {
   481					requireInjectiveIdentityTuple(t, ids)
   482				}
   483				engine := plugin.Ref{ID: plugin.ID(ids.engine), Kind: inferenceengine.Kind}
   484				fixture := newIdentityLaunchFixture(t, ids, engine, engine)
   485				plan, err := BuildLaunch(context.Background(), fixture.registry, fixture.request, agentic.LaunchModeExec)
   486				if err != nil {
   487					t.Fatalf("BuildLaunch identity case %d (%+v): %v", index, ids, err)
   488				}
   489				wantProvenance := agentic.LaunchProvenance{
   490					Broker: ids.vendor, Runtime: ids.runtime, Profile: ids.profile, Model: ids.model,
   491					Publisher: ids.publisher, Family: ids.family,
   492					RequestedEngine: engine, ResolvedEngine: engine,
   493				}
   494				if plan.Provenance != wantProvenance {
   495					t.Fatalf("identity case %d provenance = %#v, want %#v", index, plan.Provenance, wantProvenance)
   496				}
   497				if fixture.vendor.calls["Spawn"] != 1 || fixture.system.preflightCalls != 1 {
   498					t.Fatalf("identity case %d side effects: vendor Spawn=%d, system Preflight=%d, want 1/1",
   499						index, fixture.vendor.calls["Spawn"], fixture.system.preflightCalls)
   500				}
   501	
   502				canonicalPlan := canonicalIdentityPlan(plan, ids)
   503				graph := identityGraphSignature(t, fixture.registry, ids)
   504				if index == 0 {
   505					baselinePlan = canonicalPlan
   506					baselineGraph = graph
   507					return
   508				}
   509				if !reflect.DeepEqual(canonicalPlan, baselinePlan) {
   510					t.Fatalf("identity case %d changed non-identity launch output\n got: %#v\nwant: %#v", index, canonicalPlan, baselinePlan)
   511				}
   512				if !reflect.DeepEqual(graph, baselineGraph) {
   513					t.Fatalf("identity case %d changed graph topology: got %v, want %v", index, graph, baselineGraph)
   514				}
   515			})
   516		}
   517	}
