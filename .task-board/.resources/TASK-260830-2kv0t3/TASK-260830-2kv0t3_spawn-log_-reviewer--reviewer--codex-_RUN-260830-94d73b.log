    14	
    15	// preflightTimeout bounds every Preflightable.Preflight call BuildLaunch
    16	// makes, regardless of what ctx the caller supplied. It mirrors the shape
    17	// skill-project-management's own launch-composition and agy-preflight
    18	// timeouts already use: a named constant, never an inline literal, so a
    19	// test can shrink the effective bound without editing this file.
    20	const preflightTimeout = 10 * time.Second
    21	
    22	var (
    23		// ErrUnknownModel is returned when a spawn names a model the resolved
    24		// vendor does not declare.
    25		ErrUnknownModel = errors.New("vendorplugin: vendor declares no such model")
    26		// ErrModelNotDrivenBySystem is returned when a model is real, the runtime
    27		// is real, and the model never declared that harness. It is a refusal
    28		// rather than a best effort: a launch on an undeclared harness is a run
    29		// nobody has evidence works.
    30		ErrModelNotDrivenBySystem = errors.New("vendorplugin: model does not declare the runtime's agentic system")
    31		// ErrEffortMissing is returned when a required-effort model was given no
    32		// effort. The refusal names the vocabulary and the vendor's recommendation
    33		// so an agent hitting it mid-run can fix the call from the error text —
    34		// which is what invariant 4 of docs/architecture.md asks of a refusal.
    35		// Nothing substitutes the recommendation: a launch that silently ran at a
    36		// default is the wrong-cost launch that invariant exists to close.
    37		ErrEffortMissing = errors.New("vendorplugin: model requires an explicit reasoning effort")
    38		// ErrEffortNotInVocabulary is returned when an effort word is not one the
    39		// model accepts, or when a model with no effort axis was given one.
    40		ErrEffortNotInVocabulary = errors.New("vendorplugin: effort is not in the model's vocabulary")
    41		// ErrAvailabilityInvalid is returned when a verdict's state and its
    42		// evidence contradict each other.
    43		ErrAvailabilityInvalid = errors.New("vendorplugin: availability verdict contradicts its own evidence")
    44		// ErrVendorContract is returned when a vendor plugin answers a dispatch
    45		// surface with something the contract forbids — most importantly a launch
    46		// request that redirects the launch away from what was admitted. A plugin
    47		// bug surfaces as a refusal here rather than as a launch on the wrong
    48		// harness, the wrong model or the wrong effort.
    49		ErrVendorContract = errors.New("vendorplugin: vendor violated the plugin contract")
    50	)
    51	
    52	// SpawnRequest is everything a caller supplies for one launch through a
    53	// runtime.
    54	//
    55	// The launch parameters are agentic's own types — Goal, Budget, Composition —
    56	// rather than vendor-layer copies of them. A second Goal type here would be
    57	// the shadow-declaration disease in the type system: two structs that agree
    58	// until one of them gains a field.
    59	type SpawnRequest struct {
    60		// Runtime selects the declared (agentic system × vendor) pair.
    61		Runtime RuntimeID
    62		// Model selects a row from that runtime's vendor. It must be one the
    63		// vendor declares AND one that declares the runtime's system.
    64		Model ModelID
    65		// Effort is the reasoning effort in the MODEL's vocabulary. It is required
    66		// for a model whose effort support is required, refused for a model with
    67		// no effort axis, and never defaulted.
    68		Effort string
    69		// Engine is an optional caller expectation. When present it must exactly
    70		// match the runtime/model declaration and the graph-resolved identity.
    71		Engine plugin.Ref
    72	
    73		// PromptPath is the assignment prompt file on disk; Prompt is its bytes
    74		// for a system whose transport is stdin. Which one a harness reads is the
    75		// agentic system's declaration.
    76		PromptPath string
    77		Prompt     []byte
    78	
    79		// WorkDir is the child's working directory; Home overrides the harness
    80		// configuration home. Home is load-bearing beyond the launch: on-disk
    81		// limit state is keyed by (provider, home).
    82		WorkDir string
    83		Home    string
    84	
    85		// Profile is the harness-side named configuration profile a launch runs
    86		// under, carried straight onto agentic.LaunchRequest.Profile by the
    87		// vendors that use it. It is transport for a fact a vendor may need to
    88		// fill in (local-models fills it from its own pointer when the caller
    89		// left it empty) rather than a value this layer interprets itself.
    90		Profile string
    91	
    92		// Env is the parent environment the child inherits from, before the
    93		// system's filtering and the vendor's additions.
    94		Env []string
    95	
    96		// Run is the tracked-run identity the agentic system exports to the
    97		// child. It stays on the typed request surface so a vendor cannot force a
    98		// consumer to duplicate agentic.WithRunContext through ad-hoc Env entries.
    99		Run agentic.RunContext
   100	
   101		Goal        *agentic.Goal
   102		Budget      *agentic.Budget
   103		ServiceTier string
   104		Composition agentic.Composition
   105	}
   106	
   107	// BuildLaunch resolves one launch through both layers.
   108	//
   109	// It is the single dispatch site for the Vendor contract: every surface the
   110	// interface exposes is reached from here or from CheckAvailability, by
   111	// identifier lookup, with no switch over vendor or runtime identifiers
   112	// anywhere. Adding a vendor is a registration, and adding a runtime is a
   113	// declaration.
   114	//
   115	// The order is deliberate. Resolution first, so a refusal names the missing
   116	// plugin rather than a symptom. Then the model row and the effort word, which
   117	// are the vendor's own vocabulary and must be validated before a plugin is
   118	// asked to build anything. Then the plugin's Spawn. Then a fidelity check on
   119	// what it returned — a vendor may ADD to a launch (authentication env, a
   120	// configuration home) and may not REDIRECT it. Then agentic.BuildPlan, which
   121	// applies the Layer-1 contract checks: the effort transport, the launch mode,
   122	// the composition grammar, the goal/budget/tier support.
   123	//
   124	// What it does NOT do is ask whether the launch is allowed RIGHT NOW.
   125	// Availability, limit state and admission are a separate question with a
   126	// separate entry point (CheckAvailability), and folding them in here would
   127	// make an expressibility check depend on a network read — with ONE
   128	// exception: the optional, generic Preflightable step below, which exists
   129	// precisely because a cold-start-safe, fail-closed advisory check on THIS
   130	// launch attempt is a different question from either of those and belongs at
   131	// the one place every launch already passes through.
   132	func BuildLaunch(ctx context.Context, r *Registry, req SpawnRequest, mode agentic.LaunchMode) (agentic.Plan, error) {
   133		if r == nil {
   134			return agentic.Plan{}, errors.New("vendorplugin: cannot build a launch without a registry")
   135		}
   136		binding, err := resolveLaunchBinding(r, req.Runtime)
   137		if err != nil {
   138			return agentic.Plan{}, err
   139		}
   140	
   141		model, err := selectModel(binding, req.Model)
   142		if err != nil {
   143			return agentic.Plan{}, err
   144		}
   145		requestedEngine, resolvedEngine, err := resolveInferenceEngine(r, binding.Engine, model.Engine, req.Engine)
   146		if err != nil {
   147			return agentic.Plan{}, err
   148		}
   149		if !model.DrivenBy(binding.SystemID) {
   150			return agentic.Plan{}, fmt.Errorf("%w: runtime %s runs on %q and model %q declares %v",
   151				ErrModelNotDrivenBySystem, binding.ID, binding.SystemID, model.ID, model.Systems)
   152		}
   153	
   154		effort, err := resolveEffort(binding.ID, model, req.Effort)
   155		if err != nil {
   156			return agentic.Plan{}, err
   157		}
   158		if requestedEngine != (plugin.Ref{}) && mode != agentic.LaunchModeDryRun {
   159			if _, err := resolveEngineObservations(ctx, r.engineFacts, requestedEngine, engineObservationQuery{
   160				Runtime: binding.ID,
   161				Profile: req.Profile,
   162				Model:   model.ID,
   163			}); err != nil {
   164				return agentic.Plan{}, fmt.Errorf("vendorplugin: inference-engine observations refused before launch: %w", err)
   165			}
   166		}
   167	
   168		var launch agentic.LaunchRequest
   169		if binding.SystemOnly() {
   170			// A system-only binding has declaration-owned model facts and no vendor
   171			// contribution by definition. This is an explicit generic branch on the
   172			// binding shape, never on a runtime id: no broker is fabricated and no
   173			// consumer needs a muse-specific fallback.
   174			launch = passthroughLaunchRequest(binding.SystemID, model, effort, req)
   175		} else {
   176			runtime := binding.Runtime()
   177			launch, err = binding.Vendor.Spawn(SpawnContext{
   178				Runtime: runtime,
   179				Model:   model,
   180				Effort:  effort,
   181				Request: req,
   182			})
   183			if err != nil {
   184				return agentic.Plan{}, fmt.Errorf("vendorplugin: vendor %s could not build the launch request for model %q: %w", binding.VendorID, model.ID, err)
   185			}
   186			if err := checkLaunchFidelity(runtime, model, effort, req, launch); err != nil {
   187				return agentic.Plan{}, err
   188			}
   189		}
   190	
   191		// Runtime is set HERE, uniformly, for every runtime — never by an
   192		// individual vendor's Spawn. A vendor double that set it itself (buggy or
   193		// not) is overwritten: this is the one place the fact is authoritative,
   194		// sourced from the SAME req.Runtime every resolution above already used.
   195		launch.Runtime = string(req.Runtime)
   196	
   197		if mode != agentic.LaunchModeDryRun {
   198			if p, ok := binding.System.(agentic.Preflightable); ok {
   199				preflightCtx, cancel := context.WithTimeout(ctx, preflightTimeout)
   200				defer cancel()
   201				if _, err := p.Preflight(preflightCtx, launch); err != nil {
   202					return agentic.Plan{}, fmt.Errorf("vendorplugin: preflight refused runtime %s: %w", binding.ID, err)
   203				}
   204			}
   205		}
   206	
   207		plan, err := agentic.BuildPlan(r.systems, launch, mode)
   208		if err != nil {
   209			return agentic.Plan{}, err
   210		}
   211		if requestedEngine != (plugin.Ref{}) {
   212			plan.Provenance = agentic.LaunchProvenance{
   213				Broker: string(binding.VendorID), Runtime: string(binding.ID), Profile: launch.Profile, Model: string(model.ID),
   214				Publisher: model.Publisher, Family: model.Family,
   215				RequestedEngine: requestedEngine, ResolvedEngine: resolvedEngine,
   216			}
   217		}
   218		return plan, nil
   219	}
   220	
   221	// launchBinding is the one internal shape BuildLaunch dispatches through.
   222	// Most bindings resolve a registered Vendor. A declaration whose broker was
   223	// positively looked for but never established may instead own validated model
   224	// rows itself and launch directly through its registered agentic System. The
   225	// two shapes are disjoint: RuntimeDeclaration.Validate refuses declaration
   226	// rows when a vendor is named.
   227	type launchBinding struct {
   228		ID       RuntimeID
   229		SystemID agentic.SystemID
   230		System   agentic.System
   231		VendorID VendorID
   232		Vendor   Vendor
   233		Models   []Model
   234		Engine   plugin.Ref
   235	}
   236	
   237	func (b launchBinding) SystemOnly() bool { return b.Vendor == nil }
   238	
   239	func (b launchBinding) Runtime() Runtime {
   240		return Runtime{ID: b.ID, SystemID: b.SystemID, System: b.System, VendorID: b.VendorID, Vendor: b.Vendor, Engine: b.Engine}
