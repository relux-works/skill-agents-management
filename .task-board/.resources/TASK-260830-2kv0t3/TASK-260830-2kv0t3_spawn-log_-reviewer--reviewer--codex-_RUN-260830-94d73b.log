   216	func buildLocalQwenConsumerProvenance(t *testing.T) (*vendorplugin.Registry, agentic.LaunchProvenanceV1) {
   217		t.Helper()
   218		reader := &countingStatusReader{status: localruntime.Status{BrokerState: "absent", BrokerSource: localruntime.SourceDetermined}}
