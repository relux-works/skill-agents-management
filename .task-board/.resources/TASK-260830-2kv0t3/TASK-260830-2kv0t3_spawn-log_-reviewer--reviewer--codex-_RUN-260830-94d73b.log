    17	var testEngineRef = plugin.Ref{ID: "test-engine", Kind: inferenceengine.Kind}
    18	
    19	type scriptedEngineFactSource struct {
    20		kind      inferenceengine.EngineKind
    21		overrides map[inferenceengine.Fact]inferenceengine.ReadOutcome
    22		calls     int
    23		before    func()
    24	}
    25	
    26	func (source *scriptedEngineFactSource) ReadEngineFacts(_ context.Context, _ plugin.Ref, _ engineObservationQuery) (inferenceengine.EngineKind, []inferenceengine.Reading, error) {
    27		source.calls++
    28		if source.before != nil {
    29			source.before()
    30		}
    31		kind := source.kind
    32		if kind == "" {
    33			kind = inferenceengine.EngineKindNativeTransformer
    34		}
    35		values := map[inferenceengine.Fact]inferenceengine.ReadOutcome{
    36			inferenceengine.FactSSHForwarding: inferenceengine.ReadAbsent(),
    37		}
    38		for fact, outcome := range source.overrides {
    39			values[fact] = outcome
    40		}
    41		readings := make([]inferenceengine.Reading, 0, len(inferenceengine.MeasuredFacts()))
    42		for _, definition := range inferenceengine.MeasuredFacts() {
    43			outcome, ok := values[definition.Fact]
    44			if !ok {
    45				outcome = inferenceengine.ReadValue(goodEngineFactValue(definition.Fact))
    46			}
    47			readings = append(readings, inferenceengine.NewReading(definition.Fact, outcome))
    48		}
    49		return kind, readings, nil
    50	}
    51	
    52	func goodEngineFactValue(fact inferenceengine.Fact) string {
    53		switch fact {
    54		case inferenceengine.FactContextArgv:
    55			return `["--ctx-size","4096"]`
    56		case inferenceengine.FactPrefillArgv:
    57			return `["--ubatch-size","512"]`
    58		case inferenceengine.FactReasoningStreamField:
    59			return "delta.reasoning_content"
    60		case inferenceengine.FactHealth:
    61			return `{"endpoint":"/health","healthy":true}`
    62		case inferenceengine.FactReadiness:
    63			return `{"weights_resident":true}`
    64		case inferenceengine.FactWeightArtifact:
    65			return `{"format":"safetensors","model_path":"/models/weights.safetensors","config_path":"/models/config.json"}`
    66		case inferenceengine.FactMemoryAccounting:
    67			return `{"method":"resident-bytes","bytes":4096,"includes_mapped_weights":true}`
    68		case inferenceengine.FactSpeculativeDecoding:
    69			return `{"capable":true,"active":false}`
    70		case inferenceengine.FactLoadState:
    71			return `{"state":"loaded","weights_resident":true}`
    72		case inferenceengine.FactUnloadState:
    73			return `{"state":"unloaded","weights_resident":false}`
    74		case inferenceengine.FactInferenceBusy:
    75			return `{"busy":false}`
    76		case inferenceengine.FactMemoryPressureSequence:
    77			return `{"pressure":"normal","consulted":["load-state","unload-state","inference-busy"],"action":"none"}`
    78		case inferenceengine.FactLocalExecutable:
    79			return "/opt/agents-infra/bin/mlx-server"
    80		case inferenceengine.FactLocalArgv:
    81			return `["--port","8080"]`
    82		case inferenceengine.FactSSHForwarding:
    83			return `{"host":"model-host","local_port":8080,"remote_port":8080}`
    84		case inferenceengine.FactStressPolicy:
    85			return `{"enabled":true,"max_concurrency":2}`
    86		case inferenceengine.FactRestartSupervisionPolicy:
    87			return `{"max_attempts":3,"initial_backoff_ms":100,"max_backoff_ms":1000}`
    88		default:
    89			panic("unknown inference-engine fact: " + fact)
    90		}
    91	}
