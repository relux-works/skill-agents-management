   231	func mutatePersistedProvenance(t *testing.T, projection agentic.LaunchProvenanceV1, mutate func(map[string]any)) agentic.LaunchProvenanceV1 {
   232		t.Helper()
   233		body, err := json.Marshal(projection)
   234		if err != nil {
   235			t.Fatalf("Marshal provenance: %v", err)
   236		}
   237		var record map[string]any
   238		if err := json.Unmarshal(body, &record); err != nil {
   239			t.Fatalf("Unmarshal persisted provenance: %v", err)
   240		}
   241		mutate(record)
   242		body, err = json.Marshal(record)
   243		if err != nil {
   244			t.Fatalf("Marshal mutated provenance: %v", err)
   245		}
   246		var persisted agentic.LaunchProvenanceV1
   247		if err := json.Unmarshal(body, &persisted); err != nil {
   248			t.Fatalf("Unmarshal consumer provenance: %v", err)
   249		}
   250		return persisted
   251	}
