   644		system := &identitySystem{pangolinSystem: systemDouble}
   645		systems := agentic.NewRegistry()
   646		if err := systems.Register(system); err != nil {
   647			t.Fatalf("Register(%s system): %v", ids.system, err)
   648		}
   649		vendorDouble := newNarwhal()
   650		vendorDouble.id = VendorID(ids.vendor)
   651		model := vendorDouble.models[0]
   652		model.ID = ModelID(ids.model)
   653		model.Publisher = ids.publisher
   654		model.Family = ids.family
   655		model.Systems = []agentic.SystemID{agentic.SystemID(ids.system)}
   656		vendorDouble.models = []Model{model}
   657		return NewRegistry(systems), system, &identityVendor{narwhalVendor: vendorDouble}
   658	}
