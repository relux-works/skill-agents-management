   142	func TestBuildLaunchRunsTrustedMLXObservationGateBeforeLaunchEffects(t *testing.T) {
   143		ids := launchIdentityCorpus()[0]
   144		engine := plugin.Ref{ID: "mlx", Kind: inferenceengine.Kind}
   145		fixture := newIdentityLaunchFixture(t, ids, engine, engine)
   146		source := &scriptedEngineFactSource{
   147			kind: inferenceengine.EngineKindNativeTransformer,
   148			overrides: map[inferenceengine.Fact]inferenceengine.ReadOutcome{
   149				inferenceengine.FactSpeculativeDecoding: inferenceengine.ReadAbsent(),
   150			},
   151		}
   152		source.before = func() {
   153			if fixture.vendor.calls["Spawn"] != 0 || fixture.system.preflightCalls != 0 {
   154				t.Fatalf("engine gate ran after launch effects: Spawn=%d Preflight=%d", fixture.vendor.calls["Spawn"], fixture.system.preflightCalls)
   155			}
   156		}
   157		fixture.registry.engineFacts = source
   158	
   159		plan, err := BuildLaunch(context.Background(), fixture.registry, fixture.request, agentic.LaunchModeExec)
   160		if err != nil {
   161			t.Fatalf("BuildLaunch(mlx): %v", err)
   162		}
   163		if source.calls != 1 || fixture.vendor.calls["Spawn"] != 1 || fixture.system.preflightCalls != 1 {
   164			t.Fatalf("calls source/Spawn/Preflight = %d/%d/%d, want 1/1/1", source.calls, fixture.vendor.calls["Spawn"], fixture.system.preflightCalls)
   165		}
   166		if plan.Provenance.ResolvedEngine != engine {
   167			t.Fatalf("resolved engine = %#v, want shipped identity %#v", plan.Provenance.ResolvedEngine, engine)
   168		}
   169	}
