   419	func newIdentityLaunchFixture(t *testing.T, ids launchIdentityTuple, runtimeEngine, modelEngine plugin.Ref, extraEngines ...plugin.Ref) identityLaunchFixture {
   420		t.Helper()
   421		systemDouble := newPangolinSystem()
   422		systemDouble.id = agentic.SystemID(ids.system)
   423		system := &identitySystem{pangolinSystem: systemDouble}
   424		systems := agentic.NewRegistry()
   425		if err := systems.Register(system); err != nil {
   426			t.Fatalf("Register(%s system): %v", ids.system, err)
   427		}
   428	
   429		registry := newRegistryWithEngineFactSource(systems, &scriptedEngineFactSource{})
   430		registered := make(map[plugin.Ref]bool)
   431		for _, ref := range append([]plugin.Ref{{ID: plugin.ID(ids.engine), Kind: inferenceengine.Kind}}, extraEngines...) {
   432			if ref == (plugin.Ref{}) || registered[ref] {
   433				continue
   434			}
   435			registered[ref] = true
   436			if err := registry.RegisterPlugin(inferenceengine.NewConfigured(ref.ID)); err != nil {
   437				t.Fatalf("RegisterPlugin(%s): %v", ref.ID, err)
   438			}
   439		}
   440	
   441		vendorDouble := newNarwhal()
   442		vendorDouble.id = VendorID(ids.vendor)
   443		model := vendorDouble.models[0]
   444		model.ID = ModelID(ids.model)
   445		model.Publisher = ids.publisher
   446		model.Family = ids.family
   447		model.Engine = modelEngine
   448		model.Systems = []agentic.SystemID{agentic.SystemID(ids.system)}
   449		vendorDouble.models = []Model{model}
   450		vendor := &identityVendor{narwhalVendor: vendorDouble}
   451		if err := registry.Register(vendor); err != nil {
   452			t.Fatalf("Register(%s vendor): %v", ids.vendor, err)
   453		}
   454		if err := registry.DeclareRuntime(RuntimeDeclaration{
   455			ID:     RuntimeID(ids.runtime),
   456			System: agentic.SystemID(ids.system),
   457			Vendor: VendorID(ids.vendor),
   458			Engine: runtimeEngine,
   459			Broker: BrokerProvenance{Checked: []string{"metamorphic registration"}, Found: "registered test vendor"},
   460		}); err != nil {
   461			t.Fatalf("DeclareRuntime(%s): %v", ids.runtime, err)
   462		}
   463	
   464		request := narwhalRequest()
   465		request.Runtime = RuntimeID(ids.runtime)
   466		request.Profile = ids.profile
   467		request.Model = ModelID(ids.model)
   468		request.Engine = runtimeEngine
   469		return identityLaunchFixture{registry: registry, system: system, vendor: vendor, request: request}
   470	}
