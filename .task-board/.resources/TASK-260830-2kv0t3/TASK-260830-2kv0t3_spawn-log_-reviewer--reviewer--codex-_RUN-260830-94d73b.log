    93	func engineRegistry(t *testing.T, runtimeEngine, modelEngine plugin.Ref) *Registry {
    94		t.Helper()
    95		systems := systemsWithPangolin(t)
    96		registry := newRegistryWithEngineFactSource(systems, &scriptedEngineFactSource{})
    97		if err := registry.RegisterPlugin(inferenceengine.NewConfigured("test-engine")); err != nil {
    98			t.Fatalf("RegisterPlugin(engine): %v", err)
    99		}
   100		if modelEngine != (plugin.Ref{}) && modelEngine.ID != testEngineRef.ID {
   101			if err := registry.RegisterPlugin(inferenceengine.NewConfigured(modelEngine.ID)); err != nil {
   102				t.Fatalf("RegisterPlugin(model engine): %v", err)
   103			}
   104		}
   105		vendor := newNarwhal()
   106		vendor.models[0].Publisher = "narwhal-labs"
   107		vendor.models[0].Family = "narwhal"
   108		vendor.models[0].Engine = modelEngine
   109		if err := registry.Register(vendor); err != nil {
   110			t.Fatalf("Register(vendor): %v", err)
   111		}
   112		declaration := tuskDeclaration()
   113		declaration.Engine = runtimeEngine
   114		if err := registry.DeclareRuntime(declaration); err != nil {
   115			t.Fatalf("DeclareRuntime: %v", err)
   116		}
   117		return registry
   118	}
