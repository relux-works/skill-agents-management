   684		if err := registry.RegisterPlugin(testGraphPlugin{declaration: plugin.Declaration{ID: plugin.ID(ids.engine), Kind: "sidecar"}}); err != nil {
   685			t.Fatalf("register wrong-kind plugin: %v", err)
   686		}
