   695	func duplicateEngineRefusal(t *testing.T, ids launchIdentityTuple) refusalObservation {
   696		registry, system, vendor := bareIdentityRegistration(t, ids)
   697		engine := inferenceengine.NewConfigured(plugin.ID(ids.engine))
   698		if err := registry.RegisterPlugin(engine); err != nil {
   699			t.Fatalf("register first engine: %v", err)
   700		}
   701		before := registry.Graph().Len()
   702		err := registry.RegisterPlugin(engine)
   703		if registry.Graph().Len() != before {
   704			t.Fatal("duplicate-engine refusal mutated the graph")
   705		}
   706		return registrationRefusal(err, system, vendor)
   707	}
   708	
   709	func cyclicEngineRefusal(t *testing.T, ids launchIdentityTuple) refusalObservation {
   710		registry, system, vendor := bareIdentityRegistration(t, ids)
   711		aID := plugin.ID(ids.engine + "-cycle-a")
   712		bID := plugin.ID(ids.engine + "-cycle-b")
   713		a := testGraphPlugin{declaration: plugin.Declaration{ID: aID, Kind: inferenceengine.Kind, Dependencies: []plugin.Ref{{ID: bID, Kind: inferenceengine.Kind}}}}
   714		b := testGraphPlugin{declaration: plugin.Declaration{ID: bID, Kind: inferenceengine.Kind, Dependencies: []plugin.Ref{{ID: aID, Kind: inferenceengine.Kind}}}}
   715		before := registry.Graph().Len()
   716		err := registry.Graph().RegisterAll(a, b)
   717		if registry.Graph().Len() != before {
   718			t.Fatal("cyclic batch refusal mutated the graph")
   719		}
   720		return registrationRefusal(err, system, vendor)
   721	}
