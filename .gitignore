# Build outputs. Anchored on purpose: an unanchored `agents-management`
# pattern matches directories too, and would silently ignore the entire
# tools/agents-management source tree.
/agents-management
/tools/agents-management/agents-management
dist/

# Temporary utilities, logs, worktrees, smoke artifacts
.temp/

# Local agent runtime (installed by agents-infra, machine-local)
.agents/
.local/
.claude/settings.local.json

# Editor / OS noise
.DS_Store
*.swp

# Board runtime state that is not board content
.task-board/.locks/
.task-board/.runtime/

# Go
*.test
*.out
vendor/
